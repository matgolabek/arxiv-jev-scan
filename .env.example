# Copy this file to .env and fill in your key.

# API key from https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Price used for the cost column, in USD per 1M input tokens.
# 0.042 is the public jev-1.13 price (output tokens are free).
# Change it if your plan or the model price is different.
JEV_PRICE_PER_MILLION_INPUT_TOKENS=0.042

# Pin a model version instead of the moving "jev-latest" alias (optional).
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# Hugging Face repositories for the training dataset and the trained model,
# e.g. your-name/arxiv-event-cameras. `export-dataset --push` uploads to
# HF_DATASET_REPO, and the Colab notebook reads both (upload this file to
# Colab, or add them as Colab secrets). Log in with `hf auth login`, or set
# HF_TOKEN.
HF_DATASET_REPO=
HF_MODEL_REPO=
HF_TOKEN=

# Which model classifies papers: "jev" (TypeSafe's hosted Jev, paid) or
# "local" (your own model in llama.cpp's server, free; see the README).
DECISION_BACKEND=jev
# Where llama.cpp's server listens when DECISION_BACKEND=local.
LOCAL_DECISION_URL=http://127.0.0.1:8080
# Seconds to wait for one answer from the local model (default 120).
# LOCAL_DECISION_TIMEOUT=120
